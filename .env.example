# Скопируйте в .env и заполните. .env в git не попадает.
# Higgsfield подключается как MCP-коннектор (OAuth), ключ сюда обычно не нужен.
# Если понадобится API-ключ — только сюда, не в код.
HIGGSFIELD_API_KEY=
# Куда слать заявки с сайта (заполнить при выборе CRM/бота)
LEADS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
